# Vorlage für deine Einstellungen.
# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# Die .env wird nie hochgeladen (steht in .gitignore).
#
# Die Pipeline selbst braucht KEINE Passwörter oder Tokens:
# Drive läuft über den synchronisierten Ordner, Metricool über die Claude-Aufgabe.

# Pfad zu deinem synchronisierten Google-Drive-Ordner "Content".
# Mac (Beispiel):     /Users/tarek/Library/CloudStorage/GoogleDrive-deine@mail.com/Meine Ablage/Content
# Windows (Beispiel): G:\Meine Ablage\Content
CONTENT_ORDNER=

# Whisper-Modell für die Untertitel: tiny, base, small, medium
# "small" ist ein guter Kompromiss aus Tempo und Genauigkeit auf Deutsch.
WHISPER_MODELL=small

# Was passiert mit Querformat-Clips? "blur" = unscharfer Hintergrund, "crop" = Mitte ausschneiden
QUERFORMAT=blur

# Musik: leer lassen, dann kannst du später in der App einen Plattform-Sound wählen.
# Nur lizenzfreie Musik eintragen, für die du die Rechte hast (z. B. YouTube Audio Library).
MUSIK_DATEI=
MUSIK_LAUTSTAERKE=0.12

# Schrift für Untertitel und Hook-Text (muss auf deinem Rechner installiert sein)
SCHRIFT=Arial

# Wie oft der Wächter nach neuen Clips schaut (Sekunden)
PRUEF_INTERVALL=120

# --- Einnahmen (siehe einnahmen/FAHRPLAN.md) ---
# Hinweis auf dein eigenes Produkt. Leer lassen, solange der Shop nicht live ist: Dann passiert nichts.
# Er kommt nur an Beiträge, deren Idee-Datei unter "## Verkaufshinweis" mit "ja" beginnt (max. 1 von 4 pro Woche).
# Schreib dazu, dass es dein eigenes Produkt ist, z. B.: Mein eigener 8-Wochen-Speed-Plan: Link in Bio
VERKAUFS_HINWEIS=
# Link zur Produktseite (https://...). Pinterest-Pins führen dann direkt dorthin.
VERKAUFS_LINK=
