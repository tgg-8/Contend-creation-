<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Claude-Rädchen 🌸"
            android:textColor="@color/ink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Schau in der Claude-App unter Einstellungen → Nutzung nach und trag die Werte hier ein."
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <!-- Berechtigung -->
        <LinearLayout
            android:id="@+id/permissionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Damit das Rädchen über Claude schweben darf, braucht die App einmalig die Erlaubnis „Über anderen Apps einblenden“."
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnPermission"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/button_bg"
                android:text="Erlaubnis erteilen"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Werte -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Genutzt laut Claude (in %)"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/inputUsed"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/field_bg"
                android:hint="z. B. 38"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="3"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/previewLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/ink_soft"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Zurückgesetzt in …"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/inputHours"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_bg"
                    android:hint="Std"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="3"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/ink" />

                <EditText
                    android:id="@+id/inputMinutes"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@drawable/field_bg"
                    android:hint="Min"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:maxLength="2"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/ink" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/button_bg"
                android:text="Speichern &amp; Rädchen zeigen"
                android:textAllCaps="false"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnHide"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/button_soft_bg"
                android:text="Rädchen ausblenden"
                android:textAllCaps="false"
                android:textColor="@color/ink" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Tipp: Rädchen antippen = Sprechblase. Gedrückt halten und ziehen = verschieben."
            android:textColor="@color/ink_soft"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
